{
  "name": "railassist-monorepo",
  "version": "1.0.0",
  "description": "RailAssist PWA Workspace Launcher",
  "private": true,
  "scripts": {
    "install-all": "npm install --prefix server && npm install --prefix client --legacy-peer-deps",
    "seed": "npm run seed --prefix server",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client"
  }
}
