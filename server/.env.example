# RailAssist Server Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit the real .env file into source control.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/railassist
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Email Service Configuration for Password Reset (SMTP)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your_smtp_user
# EMAIL_PASS=your_smtp_password
# EMAIL_FROM=no-reply@railassist.internal
